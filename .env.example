# OpenAI
OPENAI_API_KEY=sk-...

# Supabase (for loading project settings and logging calls)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Frontend (Next.js) base URL — engine calls its API routes for tool execution
FRONTEND_API_URL=https://your-frontend.vercel.app

# Public dashboard URL — used to build links (e.g. conversation link in owner SMS)
PUBLIC_APP_URL=https://leadoro.io

# Engine public hostname (used to build the TwiML WebSocket URL)
# Do NOT include protocol — just the host[:port]
ENGINE_HOST=engine.your-domain.com

# Twilio auth token (for validating incoming webhook signatures)
TWILIO_AUTH_TOKEN=your_auth_token

# Set to "true" to skip Twilio signature validation (local dev only)
TWILIO_SKIP_VALIDATION=false

# Port the engine listens on (default: 8080)
PORT=8080
